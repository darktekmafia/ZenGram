# ====================================================================
# ZenGram - Git Ignore Rules
# Protects private user data, cookies, databases, downloads & binaries
# ====================================================================

# Python & Runtime
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Node.js & Frontend Bundler
node_modules/
frontend/node_modules/
frontend/dist/
dist/
.vite/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Databases, WAL journals, and SQLite files
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
instasave.db
zengram.db

# Storage, Sessions & Private User Credentials
storage/
storage/sessions/
storage/cache/
storage/downloads/
media_downloads/
*.session
*.session-journal
session.json
cookies.json
*.cookie

# Download Directories & Media Archives
Downloads/
ZenGram/
InstaSave/
*.part
*.crdownload
*.ytdl

# Environment Variables & API Secrets
.env
.env.*
!.env.example

# Playwright & Testing Artifacts
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Logs & PID tracking
*.log
logs/
*.pid

# IDEs & Operating System Artifacts
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/
*.code-workspace
*.swp
*.swo
*~
scratch/
project_preliminary_overview.txt
UI_Example_Only.jpeg

# Local Planning & Internal Implementation Notes
FUTURE_IMPLEMENTATIONS.md
COMPLETED_IMPLEMENTATIONS.md
FINAL_SECURITY_HARDENING_AND_RELEASE_VALIDATION.txt
*.local.md
ROADMAP.local.md

